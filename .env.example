# =============================================================================
# xynes-authz-service — local-dev env
# =============================================================================
#
# This service's runtime env is sourced from the canonical workspace template:
#   ../xynes-infra/.env.example
#
# That file documents every key with security notes, generation recipes, and
# cross-references to the architecture epics. Copy it to one of:
#   ../xynes-infra/.env.dev          (Docker dev stack — STORAGE_PROCESSOR_MODE,
#                                     full Supabase auth block, etc.)
#   ../xynes-infra/.env.localhost    (host-run scripts / tests)
#
# When running host-side scripts in this repo (bun run dev, bun test):
#   export XYNES_ENV_FILE=../xynes-infra/.env.localhost
# or symlink one of the canonical files via xynes-infra/scripts/link-env-files.sh.
#
# Both `.env.dev` and `.env.localhost` are git-ignored across this workspace.
# NEVER commit real values into either filename.
#
# Canonical structure + 3-level layering (local / VPS dev/qa/prod / future
# hosted secret manager):
#   ../xynes-infra/ENV_GUIDE.md
#   ../xynes-infra/infra/release/SECRETS.md
# =============================================================================

# -----------------------------------------------------------------------------
# Keys this service reads at runtime
# -----------------------------------------------------------------------------
# Placeholders below are intentionally NON-FUNCTIONAL — replace from the
# canonical template. See ../xynes-infra/.env.example for the authoritative
# list of all platform env vars; only the keys this service reads are listed
# here.

# Postgres connection. Service-specific DB user recommended; otherwise reuse
# DATABASE_URL from the canonical template.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Shared service-to-service auth token (gateway <-> authz). Generate with:
#   openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=replace-with-openssl-rand-hex-32

# Internal JWT signing key (SEC-INTERNAL-AUTH-2). Must match the value in the
# canonical template so the gateway can verify signed internal calls.
INTERNAL_JWT_SIGNING_KEY=replace-with-openssl-rand-hex-32

# Internal auth mode: `hybrid` (legacy token OR JWT) | `jwt` (JWT only).
INTERNAL_AUTH_MODE=hybrid
